# =============================================================================
# Sniper .env — copy to .env and fill in your values
# =============================================================================

# --- Core ---
DB_PATH=sniper_tracker.db
LOG_LEVEL=INFO
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_THREADED=true

# --- Telegram alerts (required for alerter service) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Memecoin thesis capture (display/context only) ---
MEMECOIN_THESIS_ENABLED=1
MEMECOIN_THESIS_UNDERWATER_PCT=-10   # their unrealized PnL % <= this -> "underwater" stance
MEMECOIN_THESIS_WINNING_PCT=20       # >= this -> "winning" stance

# --- Memecoin Telegram front-run latency instrument (external send; OFF by default) ---
# Fires a Telegram the instant we detect a curated large buy, to test if we beat fomo's push.
# Set the bot token/chat yourself (falls back to TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above),
# then flip MEMECOIN_TG_ALERTS=1. Compare the alert vs fomo's push arrival on your phone.
MEMECOIN_TG_ALERTS=0
MEMECOIN_TG_BOT_TOKEN=                # optional; falls back to TELEGRAM_BOT_TOKEN
MEMECOIN_TG_CHAT_ID=                  # optional; falls back to TELEGRAM_CHAT_ID
MEMECOIN_TG_MIN_USD=0                 # alert only on curated buys >= this size
MEMECOIN_TG_MAX_PER_POLL=5           # burst guard (avoids Telegram 429)
MEMECOIN_TG_MIN_GAP_S=3              # shared per-chat pacing; group-safe ~20 messages/minute
MEMECOIN_TG_TIMEOUT_S=8              # covers slow Telegram sends (3s dropped a real 3.16s send); a hang is still bounded

# --- Memecoin V6 modeled-live paper engine (NO FUNDS; OFF by default) ---
# Opens from accepted live signals at executable modeled quotes, then gives V6 sole post-fill
# authority. It writes only its dedicated paper DB and appears separately in Real Positions.
MEMECOIN_V6_PAPER_ENABLED=0
MEMECOIN_V6_PAPER_DB=                 # optional; defaults to data/memecoin_v6_paper.sqlite
MEMECOIN_V6_JUPITER_MIN_CALL_S=2.1     # shared keyless Jupiter lane; do not burst per position
MEMECOIN_V6_PAPER_NETWORKS=solana,4663
MEMECOIN_V6_PAPER_NOTIONAL_USD=25
MEMECOIN_V6_PAPER_MAX_OPEN=4
MEMECOIN_V6_PAPER_QUOTE_MAX_AGE_S=10
MEMECOIN_V6_EVENT_COALESCE_MS=50      # event batching; not a decision-sweep delay
MEMECOIN_V6_HEARTBEAT_S=1
MEMECOIN_V6_EVM_FALLBACK_POLL_MS=500
MEMECOIN_V6_SOLANA_BINDING_REFRESH_S=0.5
MEMECOIN_V6_QUOTE_REFRESH_S=5         # fresh executable quote cadence for open positions
MEMECOIN_V6_EVENT_CATCHUP_MAX=400

# --- Radar v5 -> V6 realistic-fill paper handoff (NO FUNDS; both sides OFF by default) ---
# Enable the V6 consumer first. Its capability heartbeat gates Radar quote requests.
MEMECOIN_V6_RADAR_CONSUMER_ENABLED=0
MEMECOIN_V6_RADAR_DB=data/memecoin_opportunity.db
MEMECOIN_V6_RADAR_HEARTBEAT=data/memecoin_v6_paper.heartbeat
MEMECOIN_V6_RADAR_HANDOFF_MAX_AGE_S=30
# Then enable Radar's lower-priority $25 executable quote lane. Do not change the clip for v1.
MEMECOIN_OPPORTUNITY_PAPER_ADAPTER=0
MEMECOIN_OPPORTUNITY_PAPER_ADAPTER_EXPIRY_S=30
MEMECOIN_OPPORTUNITY_PAPER_ADAPTER_CONSUMER_HEARTBEAT=data/memecoin_v6_paper.heartbeat
MEMECOIN_OPPORTUNITY_PAPER_ADAPTER_CONSUMER_MAX_AGE_S=120

# --- Memecoin REAL-MONEY leg (DISARMED by default — DO NOT flip until the smoke test passes) ---
# The runner AND the smoke scripts read both .env and .fomo.env, so these knobs work in either file.
# Arm gate: keep 0. Set to 1 only after funding the wallet(s) + a green smoke test. One coordinated
# runner restart is required to pick up any change here (the running process is not live-reloaded).
MEMECOIN_REAL_ENABLED=0
# Startup-only: stop paper admission, brackets and research workers; keep funded policy and exits.
MEMECOIN_FUNDED_ONLY=0
MEMECOIN_TRADE_SIZE_USD=10            # fixed clip per entry (used when MEMECOIN_REAL_SIZING=fixed)
MEMECOIN_REAL_SIZING=fixed            # fixed | bankroll (bankroll: clip = max(MIN_TRADE, equity/MAX_CONCURRENT))
MEMECOIN_MIN_TRADE_USD=30            # bankroll-mode clip floor
MEMECOIN_MAX_CONCURRENT=7            # GLOBAL open+reserved cap across Solana + EVM
MEMECOIN_MAX_TOTAL_EXPOSURE_USD=700  # GLOBAL entry-cost exposure cap; balances/gas stay chain-local
MEMECOIN_DAILY_LOSS_LIMIT_USD=30     # GLOBAL latched daily-loss breaker; 0 = disabled (no floor but the wallet)
MEMECOIN_REAL_POLICY=alpha_b         # the one exit policy that goes live (mirror-sell + the rails below)
# REAL-leg exit rails (decoupled from the paper alpha_b A/B knobs; each 0 = that rail OFF)
MEMECOIN_REAL_STOP_PCT=50            # catastrophe stop, % below entry
MEMECOIN_REAL_MAX_HOLD_S=43200       # hard timecap (s)
MEMECOIN_REAL_TP_PCT=0               # FULL take-profit, % above entry
MEMECOIN_REAL_DERISK_PCT=40          # one-shot de-risk: sell back the entry notional, ride the rest
MEMECOIN_REAL_LEGACY_TP_PCT=60       # pre-cutover bags keep the former fixed TP
# Funded contract/classifier defaults. The coordinated deploy writes the cutoff only after stopping
# the old runner and rechecking zero reservations; do not hand-anchor it while old code is live.
MEMECOIN_FUNDED_CONTRACT_MIN_RESERVED_AT=
MEMECOIN_FUNDED_CLASSIFICATION_VERSION=1
MEMECOIN_FUNDED_REGIME_RISK_SCALE=0.75
MEMECOIN_FUNDED_TAPE_WINDOW_S=900
MEMECOIN_FUNDED_TAPE_MIN_OBSERVATIONS=3
MEMECOIN_FUNDED_TAPE_MIN_SPAN_S=30
MEMECOIN_FUNDED_POST_PEAK_RUNUP_PCT=20
MEMECOIN_FUNDED_POST_PEAK_GIVEBACK_PCT=30
MEMECOIN_FUNDED_REGIME_BUCKET_S=900
MEMECOIN_FUNDED_REGIME_BASELINE_BUCKETS=23
MEMECOIN_FUNDED_REGIME_MIN_NONEMPTY_BUCKETS=8
MEMECOIN_FUNDED_REGIME_MIN_BASELINE_BUYS=30
MEMECOIN_FUNDED_REGIME_MAX_STALENESS_S=180
# Frozen per-band funded rails: nano <50k, micro <250k, small <1m, mid <2m; >=2m is out-of-scope.
MEMECOIN_REAL_NANO_DERISK_PCT=40
MEMECOIN_REAL_NANO_TRAIL_PCT=40
MEMECOIN_REAL_NANO_SL_PCT=60
MEMECOIN_REAL_MICRO_DERISK_PCT=50
MEMECOIN_REAL_MICRO_TRAIL_PCT=50
MEMECOIN_REAL_MICRO_SL_PCT=60
MEMECOIN_REAL_MID_DERISK_PCT=30
MEMECOIN_REAL_MID_TRAIL_PCT=35
MEMECOIN_REAL_MID_SL_PCT=60
# Solana custody + RPC (0600 keypair OUTSIDE the repo; Helius or equivalent RPC — embeds a key, keep secret)
MEMECOIN_SOLANA_KEYPAIR=data/solana_keypair.json
MEMECOIN_SOLANA_RPC_URL=
# legacy is the default. Shyft roles require explicit HTTPS rpc.shyft.to URLs with api_key auth.
# Distinct keys do not prove quota isolation; record actual account allocations before cutover.
MEMECOIN_SOLANA_INFRA_PROVIDER=legacy
MEMECOIN_SOLANA_RPC_POOL_URLS=
ONCHAIN_WATCH_SOLANA_RPC_URL=
MEMECOIN_RESEARCH_SOLANA_RPC_URLS=
# MEMECOIN_SOLANA_READ_RPC_URL=
MEMECOIN_TPU_RPC_URL=
MEMECOIN_SOL_COHORT_RPC_URL=
# EVM custody + routing (SEPARATE wallet; per-chain RPC via MEMECOIN_EVM_RPC_URL_<chainid>). Base only
# by default (MEMECOIN_EVM_ALLOWLIST=8453); BSC held out until per-chain USDC decimals + a BSC smoke.
MEMECOIN_EVM_ALLOWLIST=8453
MEMECOIN_EVM_KEYPAIR=data/evm_keypair.json
MEMECOIN_EVM_RPC_URL=
# MEMECOIN_EVM_RPC_URL_8453=          # Base-specific RPC override (optional)
# MEMECOIN_EVM_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com   # Robinhood Chain (WETH-quoted;
#   held out of the allowlist until fomo carries 4663 events — the runner's new-network tripwire pages)
# Isolated read-only Opportunity Radar capture. Default OFF; no signer, orders, or funded DB writes.
# MEMECOIN_OPPORTUNITY_CAPTURE=0
# MEMECOIN_OPPORTUNITY_SOLANA_RPC_URL=
# MEMECOIN_OPPORTUNITY_SOLANA_WS_URL=
# MEMECOIN_OPPORTUNITY_BAGS_SOLANA_WS_URL=
# MEMECOIN_OPPORTUNITY_SOLANA_ORPHAN_AFTER_S=120
# MEMECOIN_OPPORTUNITY_QUOTE_MAX_QUEUE_AGE_MS=2000
# MEMECOIN_OPPORTUNITY_QUOTE_MAX_PAIR_AGE_MS=3500
# MEMECOIN_OPPORTUNITY_QUOTE_MAX_COMPLETION_AGE_MS=1000
# MEMECOIN_OPPORTUNITY_QUOTE_CACHE_MAX=256
# MEMECOIN_OPPORTUNITY_QUOTE_COMPLETION_MAX=256
# MEMECOIN_OPPORTUNITY_4663_RPC_URL=
# MEMECOIN_OPPORTUNITY_4663_WS_URL=
# MEMECOIN_OPPORTUNITY_4663_POLL_S=2
# Native USD prices refresh in-process from CoinGecko; `env` requires externally refreshed timestamps.
# MEMECOIN_OPPORTUNITY_NATIVE_PRICE_SOURCE=coingecko
# MEMECOIN_OPPORTUNITY_NATIVE_PRICE_REFRESH_S=30
# MEMECOIN_OPPORTUNITY_SOL_NETWORK_COST_LAMPORTS=5000
# MEMECOIN_OPPORTUNITY_4663_NETWORK_COST_WEI=
# Per-chain funded execution venue: verified direct DEX or disabled (missing = disabled, fail-closed).
# MEMECOIN_EVM_EXEC_VENUE_8453=direct
# MEMECOIN_EVM_EXEC_VENUE_4663=direct
# Entry-speed flag: pipelined approval broadcasts the exact-amount approval without a receipt wait.
# Safety reads always run with the quote and join before the first wallet mutation.
# MEMECOIN_EVM_APPROVAL_PIPELINE=1
# MEMECOIN_EVM_APPROVAL_PIPELINE_CHAINS=4663  # required allowlist; keep Base receipt-first
MEMECOIN_ZEROX_API_KEY=

# --- Polymarket ---
# File containing your CLOB API private key
WALLET_KEY_FILE=.wallet_key
# Polygon RPC (for on-chain redemption; not needed for paper trading)
POLYGON_RPC_URL=

# --- Real trading (keep disabled until proof bar is met) ---
REAL_TRADING_ENABLED=false
REDEEM_DRY_RUN=true
REDEEM_ARMED=false

# --- API protection ---
SNIPER_API_VERSION=2026.02-sniper-v1
SNIPER_API_KEY=
SNIPER_API_KEY_PROTECT_MUTATING=false

# --- NewsAPI (free tier: 100 requests/day) ---
# Get your key from: https://newsapi.org
NEWS_API_KEY=

# --- Paper trading ---
# PAPER_POSITION_SIZE_USDC=25
# PAPER_MAX_CONCURRENT=4
# PAPER_STOP_LOSS_PCT=0.15
# PAPER_TAKE_PROFIT_PCT=0.50
# PAPER_MAX_EXPOSURE_PER_MARKET_USDC=200

# --- Real trader (Phase 2 — do not enable yet) ---
# RT_MAX_POSITION_USDC=50
# RT_MIN_POSITION_USDC=5
# RT_MIN_INSIDER_SCORE=55
# RT_MAX_SPECULATOR_SCORE=70
# RT_MAX_ENTRY_PRICE=0.70

# --- Replay Engine ---
# REPLAY_DEFAULT_BANKROLL=1000.0
# REPLAY_DEFAULT_BASE_SIZE=25.0
# REPLAY_DEFAULT_MIN_INSIDER=55.0
# REPLAY_DEFAULT_MAX_SPEC=70.0
# REPLAY_DEFAULT_MAX_PRICE=0.70
# REPLAY_DEFAULT_MAX_CONCURRENT=20
# REPLAY_DEFAULT_MAX_MARKET_EXPOSURE=200.0
# REPLAY_DEFAULT_MAX_TOTAL_EXPOSURE=1000.0

# --- Instance Profile (Multi-Strategy / Multi-VPS) ---
# INSTANCE_TAG=insider-main-paper        # Unique identifier for this deployment
# INSTANCE_DISPLAY_NAME=Insider Main     # Human-readable name
# INSTANCE_ROLE=paper                    # paper | real
# INSTANCE_ENABLED=1                     # 0 to disable all strategy execution
# ENABLED_STRATEGIES=insider_copy_v1     # Comma-separated plugin IDs to run
# ENABLED_FEEDS=polymarket               # Comma-separated feed IDs to initialize
# PAPER_ONLY=1                           # 1 forces real trading off
# REAL_TRADING_ENABLED=0                 # 1 to allow real execution (requires PAPER_ONLY=0)
# INSTANCE_BANKROLL_USDC=1000            # Starting bankroll for risk policy
# INSTANCE_MAX_TOTAL_EXPOSURE_USDC=1000  # Max total open exposure
# INSTANCE_MAX_MARKET_EXPOSURE_USDC=200  # Max exposure per market
# INSTANCE_MAX_CONCURRENT_POSITIONS=20   # Max open positions
# INSTANCE_DAILY_LOSS_LIMIT_USDC=50      # Daily loss circuit breaker
# STRATEGY_LOOP_SECONDS=60               # Default loop interval

# --- Weather Feed (experimental) ---
# OPENWEATHER_API_KEY=                    # OpenWeatherMap API key (free tier)
# WEATHER_LOCATIONS=london,new_york,tokyo # Comma-separated city keys to poll

# --- Example: Weather Paper Instance (second VPS) ---
# Copy this block to .env on the experimental VPS:
#
#   INSTANCE_TAG=weather-paper-us
#   INSTANCE_DISPLAY_NAME=Weather Paper US
#   INSTANCE_ROLE=paper
#   ENABLED_STRATEGIES=weather_v1
