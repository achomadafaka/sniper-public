#   PAPER_ONLY=1
#   INSTANCE_BANKROLL_USDC=500
#   INSTANCE_MAX_TOTAL_EXPOSURE_USDC=500
#   INSTANCE_MAX_MARKET_EXPOSURE_USDC=50
#   INSTANCE_MAX_CONCURRENT_POSITIONS=5
#   INSTANCE_DAILY_LOSS_LIMIT_USDC=25
#   STRATEGY_LOOP_SECONDS=300
#   COMMODITY_SYMBOLS=BZ=F,CL=F,GC=F,NG=F

# --- Odds Feed (The Odds API) ---
# Keys file (highest priority) — one key per line, # comments ok, re-read each tick:
# ODDS_API_KEYS_FILE=odds_keys.txt
# Multiple free keys (comma-separated) — rotates automatically on quota exhaustion:
# ODDS_API_KEYS=key1,key2,key3
# Single key (backward compat):
# ODDS_API_KEY=<your-the-odds-api-key>
# ODDS_SPORT_KEYS=basketball_nba,basketball_ncaab
# ODDS_BOOKMAKERS=              # leave empty for all, or CSV whitelist
# ODDS_MARKETS=h2h              # fixed to h2h in v1
# ODDS_POLL_SECONDS=600

# --- Example: Sports Line Dislocation Paper Instance ---
# IMPORTANT: Must use a SEPARATE DB file from insider-copy instance.
# Copy this block to .env on the sports-line VPS/instance:
#
#   DB_PATH=sniper_sports.db
#   INSTANCE_TAG=sports-line-paper
#   INSTANCE_DISPLAY_NAME=Sports Line Dislocation Paper
#   INSTANCE_ROLE=paper
#   ENABLED_STRATEGIES=sports_line_dislocation_v1
#   ENABLED_FEEDS=polymarket,odds
#   PAPER_ONLY=1
#   REAL_TRADING_ENABLED=0
#   INSTANCE_BANKROLL_USDC=500
#   INSTANCE_MAX_TOTAL_EXPOSURE_USDC=500
#   INSTANCE_MAX_MARKET_EXPOSURE_USDC=50
#   INSTANCE_MAX_CONCURRENT_POSITIONS=5
#   INSTANCE_DAILY_LOSS_LIMIT_USDC=25
#   STRATEGY_LOOP_SECONDS=300
#   ODDS_API_KEY=<your-the-odds-api-key>


# --- Analyst agent runtime ---
# Per-message inactivity timeout (seconds) for the Claude Agent SDK stream.
# If no message arrives within this window during a world_analyst or
# finance_analyst run, the helper kills the subprocess and raises
# TimeoutError — which triggers the fallback-model retry path. Catches
# hung tool calls (e.g. WebFetch on slow hosts) before the outer 600s
# systemd TimeoutStartSec does. Default 180 (3 min); tune lower to kill
# hangs faster or higher if you see false-fires from slow Bash tools.
# ANALYST_INACTIVITY_TIMEOUT_S=180

# VPS host for deploy/health tooling (dormant — old Amsterdam box 188.166.91.20 retired 2026-04). Set when the new VPS is provisioned.
SNIPER_VPS_HOST=

# Add real_shadow to run a paper mirror of the live real-leg rails across the full roster:
# MEMECOIN_ARMS=control,momentum_a,alpha_b,real_shadow

# Strategy Lab evidence floor: below this many independent clusters — min(matched events, unique
# coins, unique wallets) — the Paper report grades the cohort insufficient_evidence and the UI
# suppresses ranking language. 30 is the existing project floor for arm verdicts; lowering it does
# not make a thin cohort decision-grade, it only hides the warning.
# MEMECOIN_PAPER_MIN_EVIDENCE_CLUSTERS=30

# --- HL real copy leg (2026-07-17 spec) ---
# Entries-only kill switch: 0 blocks new opens; exits+reconcile always run.
HL_REAL_ENABLED=0
# Dry run: full decision path, intents recorded, nothing submitted.
HL_REAL_DRY_RUN=1
HL_REAL_PER_POS_USD=15
HL_REAL_MAX_CONCURRENT=5
HL_REAL_MAX_TOTAL_NOTIONAL=75
HL_REAL_MAX_CHASE_BPS=100
HL_REAL_DAY_LOSS_BREAKER_USD=20
HL_REAL_ENTRY_SLIPPAGE=0.005
HL_REAL_EXIT_SLIPPAGE=0.01
HL_REAL_TARGETS=0xc9c78160120cd6ecf3dea892e9ae5af4115bf5f8
# Entries only: restrict the optional real leg to non-BTC/ETH/SOL shorts. Paper-only
# research must pass its own forward gate; this flag does not prove or promote an edge.
HL_REAL_ALT_SHORT_ONLY=1
HL_REAL_API_WALLET_FILE=data/hl_api_wallet.json
HL_REAL_ACCOUNT_ADDRESS=
HL_REAL_BASE_URL=https://api.hyperliquid.xyz
HL_REAL_TAIL_SECONDS=5
# Proof lane: top-N watch_fallback wallets stay executable for PAPER copy even when a
# proven wallet exists (exact-copy evidence keeps accruing toward a second wallet). 0=off.
HL_COPY_PROOF_LANE_N=8
# Absolute catastrophe max-loss backstop % — fires on EVERY funded position regardless of a chain
# default of 0 (4663) or an override that disabled/widened the stop. Only catches death spirals, so
# it does not fight the 4663 "let -30/-50% dips recover" thesis. 0 disables (not recommended armed).
MEMECOIN_REAL_CATASTROPHE_PCT=80
# The funded EVM route can lose at most 15% in the buy and sell safety probe.
MEMECOIN_EVM_MAX_TAX_PCT=15
# Proven wallets use the same cap by default.
MEMECOIN_EVM_MAX_TAX_PCT_PROVEN=15
# The tax a V2 exit is VALUED at for the stop/TP/de-risk rails. The signed minimum output keeps
# MEMECOIN_EVM_MAX_TAX_PCT. Set it to 15 or more to roll back to valuing on the 15% cut.
MEMECOIN_EVM_EXIT_VALUE_TAX_PCT=4
# Rollover / profit-lock engine (2026-07-18): replaces the fixed TP with a default trailing stop.
# Set MEMECOIN_REAL_TP_PCT=0 to drop the hard TP; DERISK recovers principal on the way up; the trail
# arms once the peak crosses +TRAIL_ARM_PCT then exits on TRAIL_PCT giveback from the executable peak.
MEMECOIN_REAL_TRAIL_PCT=30
MEMECOIN_REAL_TRAIL_ARM_PCT=15
# Offset-aware corrected-UTC anchor for the COMPLETE TP/de-risk/trail policy. The funded deploy
# script writes this and the contract cutoff atomically with --activate-rollover after stopping old code.
MEMECOIN_REAL_ROLLOVER_MIN_OPENED_AT=
