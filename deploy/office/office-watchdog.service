[Unit]
Description=Independent Office resource watchdog
ConditionPathExists=%h/Desktop/Sniper/.runtime/office/current/scripts/office_watchdog.py

[Service]
Type=simple
WorkingDirectory=%h/Desktop/Sniper/.runtime/office/current
ExecStart=/usr/bin/bwrap --unshare-user --unshare-pid --die-with-parent --new-session --ro-bind / / --proc /proc --dev /dev --tmpfs /tmp --bind %h/Desktop/Sniper/data/office-control %h/Desktop/Sniper/data/office-control --bind-try /sys/fs/cgroup/user.slice/user-%U.slice/user@%U.service/office.slice/cgroup.kill /sys/fs/cgroup/user.slice/user-%U.slice/user@%U.service/office.slice/cgroup.kill --cap-drop ALL /usr/bin/env -i HOME=%h PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin SNIPER_STATE_ROOT=%h/Desktop/Sniper %h/.pyenv/versions/3.13.0/bin/python3 %h/Desktop/Sniper/.runtime/office/current/scripts/office_watchdog.py --sample %h/Desktop/Sniper/data/office-control/health.json --manifest %h/Desktop/Sniper/.runtime/office/current/config/office/host_guard_pilot.json --latch %h/Desktop/Sniper/data/office-control/guard/guard.json --cgroup /sys/fs/cgroup/user.slice/user-%U.slice/user@%U.service/office.slice
Nice=19
IOSchedulingClass=idle
Slice=app.slice
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=5
# bwrap needs namespace setup first; payload sets NoNewPrivs=1 and drops all caps.
NoNewPrivileges=no
LimitNOFILE=256
TasksMax=16
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
MemoryMax=134217728
CPUQuota=5%
IOWeight=1

[Install]
WantedBy=default.target
