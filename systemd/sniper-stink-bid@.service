[Unit]
Description=Sniper Stink Bid Tennis Paper Trader (strategy %i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/sniper/sniper
Environment=PYTHONPATH=/home/sniper/sniper
Environment=DB_PATH=sniper_tracker.db
EnvironmentFile=-/home/sniper/sniper/.env
ExecStart=/home/sniper/sniper/.venv/bin/python /home/sniper/sniper/sniper/services/stink_bid_runner.py --db sniper_tracker.db --strategy-id %i
Restart=always
RestartSec=10
TimeoutStopSec=20
MemoryMax=350M
MemorySwapMax=50M

[Install]
WantedBy=default.target
