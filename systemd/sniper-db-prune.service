[Unit]
Description=Sniper — Daily database pruning maintenance
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/sniper/sniper
Environment=DB_PATH=sniper_tracker.db
ExecStart=/home/sniper/sniper/.venv/bin/python3 /home/sniper/sniper/scripts/db_prune.py --execute --quiet
StandardOutput=append:/home/sniper/sniper/logs/db_prune.log
StandardError=append:/home/sniper/sniper/logs/db_prune.log
TimeoutStartSec=300
Restart=no

[Install]
WantedBy=default.target
