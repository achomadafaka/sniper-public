[Unit]
Description=Sniper — Snapshot system state into HANDOFF.md
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/sniper/sniper
EnvironmentFile=-/home/sniper/sniper/.env
Environment=CLAUDECODE=
ExecStart=/home/sniper/sniper/.venv/bin/python3 /home/sniper/sniper/scripts/update_handoff.py
StandardOutput=append:/home/sniper/sniper/logs/handoff_snapshot.log
StandardError=append:/home/sniper/sniper/logs/handoff_snapshot.log
TimeoutStartSec=60
Restart=no

[Install]
WantedBy=default.target
