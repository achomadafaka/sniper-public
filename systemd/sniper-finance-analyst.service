[Unit]
Description=Sniper Finance & Macro Intelligence Analyst
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/sniper/sniper
EnvironmentFile=-/home/sniper/sniper/.env
# Unset CLAUDECODE so analyst can launch its own Claude agent during active sessions.
Environment=CLAUDECODE=
ExecStart=/home/sniper/sniper/.venv/bin/python3 /home/sniper/sniper/sniper/services/finance_analyst.py
StandardOutput=append:/home/sniper/sniper/logs/finance_analyst.log
StandardError=append:/home/sniper/sniper/logs/finance_analyst.log
TimeoutStartSec=1200
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=default.target
