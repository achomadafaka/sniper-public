# Copy this file to .fomo.env (gitignored) and paste YOUR values from the fomo browser tab.
# These are your own account credentials — .fomo.env is gitignored; never commit it.
#
# FOMO_REFRESH_TOKEN: DevTools > Application > Local Storage > https://fomo.family
#                     key `privy:refresh_token` (paste the value WITHOUT surrounding quotes)
# FOMO_ACCESS_TOKEN : DevTools > Network > click any prod-api.fomo.family request >
#                     Headers > Request Headers > `authorization:` value AFTER "Bearer "
# FOMO_CA_ID        : Local Storage key `privy:caid` (value without quotes)  [optional]
# FOMO_PROBE_TRADER : a fomo userId to also poll /swaps for surface comparison [optional]
#                     e.g. gentlebets_ = 62d95fdd-1439-56f2-ad6e-7d81f753a3f0
FOMO_REFRESH_TOKEN=
FOMO_ACCESS_TOKEN=
FOMO_CA_ID=
FOMO_PROBE_TRADER=62d95fdd-1439-56f2-ad6e-7d81f753a3f0
FOMO_POLL_MS=500
FOMO_PROBE_SECONDS=600

# Optional live native Pump/PumpSwap detection. Requires the live Solana slot lane.
MEMECOIN_SHYFT_LIVE_ENABLED=0
MEMECOIN_SHYFT_GRPC_TOKEN=
MEMECOIN_SHYFT_GRPC_URLS=https://beta-grpc.ams.shyft.to,https://beta-grpc.fra.shyft.to
